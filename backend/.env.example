# Backend environment variables (copy to `.env` for local overrides).
# Real .env files are gitignored — never commit secrets. IrrigaSmart uses
# Open-Meteo, which requires NO API key, so most of this file has no secrets.

# Port the API listens on. Optional locally (defaults to 3001).
# On Render this is injected automatically — do NOT set it there.
PORT=3001

# Comma-separated list of origins allowed to call the API (CORS allowlist).
# Leave unset locally to allow the Vite dev server (http://localhost:5173).
# In production set this to your deployed frontend URL, e.g.:
# CORS_ORIGIN=https://irrigasmart.vercel.app
CORS_ORIGIN=

# --- Farmer assistant (backend/src/assistant.ts) ---
# Optional. Leaving both unset is a supported configuration: the route answers
# 503 ASSISTANT_DISABLED and the app falls back to its on-device offline rules.
#
# Set ONE of the two keys below, not both — if both are set, ANTHROPIC_API_KEY
# takes priority and GEMINI_API_KEY is ignored.

# Anthropic (Claude). Paid — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini. Free tier available, no credit card required —
# get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Which Gemini model to call. Ignored unless GEMINI_API_KEY is the
# active key. Defaults to gemini-flash-lite-latest, which is the model the free
# tier grants the most daily requests on — the right default for short
# explanatory answers.
#
# Set this only to move to a newer model or to pin one that is being retired.
# Nothing validates the id: a model name the API does not recognise makes every
# assistant call fail, the route report itself unavailable, and the app fall back
# to its offline rules. Check /health after changing it.
# GEMINI_MODEL=gemini-flash-lite-latest
