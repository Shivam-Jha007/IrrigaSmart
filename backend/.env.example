# Backend environment variables (copy to `.env` for local overrides).
# Real .env files are gitignored — never commit secrets.
#
# The data providers this backend proxies (Open-Meteo weather, Open-Meteo
# elevation, SoilGrids) are keyless. The two secrets are the OPTIONAL speech
# keys below — optional because the app speaks with the device's own voices
# when they are absent; they only upgrade the voice quality.

# Sarvam AI API key (V2.4 speech upgrade, PRIMARY provider for en/hi/bn).
# Server-side only; never sent to the browser.
# Without it those languages fall back to Gemini (if its key is set) or the
# device's installed speech voices — the app stays fully functional.
#
# How to get one (free ₹100 credits on signup, no billing account):
#   1. Go to https://dashboard.sarvam.ai
#   2. Create an account → API keys → copy here
#
# Pricing: Bulbul v3 is ₹30 per 10K characters (₹100 credits ≈ 33 full
# briefings), 30 requests/min on the Starter plan, no daily cap.
SARVAM_API_KEY=

# Gemini API key (V2.4 speech upgrade — Urdu's ONLY cloud voice, and the
# backstop for en/hi/bn if Sarvam fails). Server-side only.
#
# How to get one (free, ~1 minute, NO billing account):
#   1. Go to https://aistudio.google.com/apikey
#   2. Sign in with any Google account
#   3. "Create API key" → copy it here
#
# Free tier: each TTS model gets ~10 requests/day (separate per model); the
# frontend caches every synthesised sentence in IndexedDB, so each sentence
# is synthesised exactly once.
GEMINI_API_KEY=

# Port the API listens on. Optional locally (defaults to 3001).
# On Render this is injected automatically — do NOT set it there.
PORT=3001

# Comma-separated list of origins allowed to call the API (CORS allowlist).
# Leave unset locally to allow the Vite dev server (http://localhost:5173).
# In production set this to your deployed frontend URL, e.g.:
# CORS_ORIGIN=https://irrigasmart.vercel.app
CORS_ORIGIN=
