# Frontend environment variables (copy to `.env` for local overrides).
# Only VITE_-prefixed variables are exposed to the browser bundle, so never put
# secrets here — anything defined is publicly visible in the built app.

# Base URL of the backend API.
# Leave unset locally to use the default (http://localhost:3001).
# In production set this to your deployed backend URL, e.g.:
# VITE_API_BASE_URL=https://irrigasmart-backend.onrender.com
VITE_API_BASE_URL=
